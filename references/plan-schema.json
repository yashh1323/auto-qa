{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IntentDrivenQAPlan",
  "type": "object",
  "required": ["name", "planSteps"],
  "properties": {
    "projectId": { "type": "string" },
    "type": { "type": "string", "enum": ["frontend", "backend"], "default": "frontend" },
    "name": { "type": "string", "description": "Subject + verb + expected outcome" },
    "description": { "type": "string", "description": "One sentence explaining conditions and expected result" },
    "targetUrl": { "type": "string", "format": "uri" },
    "priority": { "type": "string", "enum": ["p0", "p1", "p2", "p3"], "default": "p0" },
    "planSteps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "description"],
        "properties": {
          "type": { "type": "string", "enum": ["action", "assertion"] },
          "description": { "type": "string" }
        }
      }
    }
  }
}
